{
  "name": "eventnu-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "admin-app",
    "web",
    "packages/*"
  ],
  "scripts": {
    "convex:dev": "npm -w @eventnu/convex run dev",
    "convex:deploy": "npm -w @eventnu/convex run deploy",
    "convex:codegen": "npm -w @eventnu/convex run codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.9.6"
  }
}
